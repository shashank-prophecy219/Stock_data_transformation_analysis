      "properties" : {
        "fileTabs" : [ {
          "path" : "out",
          "id" : "out",
          "language" : "sql",
          "content" : "SELECT\n        ticker,\n        Date,\n        ROUND(Close, 2) AS close_price,\n        ROUND(AVG(Close) OVER (\n          PARTITION BY ticker\n          ORDER BY Date\n          ROWS BETWEEN 199 PRECEDING AND CURRENT ROW\n        ), 2) AS ma_200,\n        COUNT(*) OVER (\n          PARTITION BY ticker\n          ORDER BY Date\n          ROWS BETWEEN 199 PRECEDING AND CURRENT ROW\n        ) AS days_in_window\n      FROM ma_filtered\n"
        } ]
      },
